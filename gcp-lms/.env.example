# National LMS - GCP Configuration

# Application
APP_NAME=National LMS (GCP)
CLOUD_PROVIDER=gcp
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=asia-south1

# Vertex AI Search
VERTEX_SEARCH_DATASTORE_ID=your-datastore-id
VERTEX_SEARCH_LOCATION=global

# Vertex AI (Gemini)
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-005

# Cloud Translation
TRANSLATION_PARENT=projects/your-project-id/locations/global
GLOSSARY_ID=academic-glossary

# Cloud Storage
GCS_BUCKET_NAME=lms-content
GCS_FRAMES_PREFIX=frames/

# Video Intelligence
VIDEO_LOCATION=asia-south1

# Translation Settings
TRANSLATION_CONFIDENCE_THRESHOLD=0.75

# Search Settings
SEARCH_TOP_K=50
SEARCH_RERANK_TOP_K=7

# Generation Settings
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=1500
