# LMS - Azure AI Foundry + Voice Live Configuration

# Application
APP_NAME=LMS
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Azure AI Foundry Project
AZURE_AI_PROJECT_CONNECTION_STRING=your-project-connection-string
AZURE_AI_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com

# Azure AI Search (for RAG)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=lms-index

# Azure Speech (Voice Live)
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# Azure Communication Services (for real-time voice calls)
AZURE_COMMUNICATION_CONNECTION_STRING=your-acs-connection-string

# Model Settings
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

# Search Settings
SEARCH_TOP_K=10

# Generation Settings
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=1500
