# Azure AI Configuration
# Copy this file to .env and fill in your values

# Azure AI Foundry endpoint
AZURE_AI_ENDPOINT=https://your-ai-foundry-endpoint.cognitiveservices.azure.com/

# Azure AI API key
AZURE_AI_API_KEY=your-api-key-here

# Azure subscription ID (optional)
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Azure resource group (optional)
AZURE_RESOURCE_GROUP=your-resource-group

# Copilot Studio settings
COPILOT_STUDIO_ENABLED=true
COPILOT_STUDIO_PORT=8000
