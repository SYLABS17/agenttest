# National LMS Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=National LMS
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-api-key
AZURE_SEARCH_INDEX_NAME=curriculum-index

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure Translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=your-api-key
AZURE_TRANSLATOR_REGION=centralindia

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER_NAME=lms-content

# Translation Settings
TRANSLATION_CONFIDENCE_THRESHOLD=0.75
TRANSLATION_TIMEOUT_SECONDS=10

# Search Settings
SEARCH_TOP_K=50
SEARCH_RERANK_TOP_K=7
SEARCH_SEMANTIC_CONFIG=curriculum-config

# Chunking Settings
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Generation Settings
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=1500

# Video Processing
VIDEO_SEGMENT_BUFFER_SECONDS=5
VIDEO_FRAME_EXTRACTION_INTERVAL=30

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
