# LMS - AWS Configuration

# Application
APP_NAME=LMS (AWS)
CLOUD_PROVIDER=aws
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Amazon OpenSearch
OPENSEARCH_ENDPOINT=https://your-domain.ap-south-1.aoss.amazonaws.com
OPENSEARCH_INDEX_NAME=curriculum-index

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon Translate
TRANSLATE_TERMINOLOGY_NAME=academic-glossary

# Amazon S3
S3_BUCKET_NAME=lms-content
S3_FRAMES_PREFIX=frames/

# Amazon Transcribe
TRANSCRIBE_LANGUAGE_CODE=en-IN

# Translation Settings
TRANSLATION_CONFIDENCE_THRESHOLD=0.75

# Search Settings
SEARCH_TOP_K=50
SEARCH_RERANK_TOP_K=7

# Generation Settings
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=1500
