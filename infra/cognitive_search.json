{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "type": "string",
      "metadata": {
        "description": "Short prefix for cognitive resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev"
    },
    "owner": {
      "type": "string"
    },
    "costCenter": {
      "type": "string"
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "basic",
        "standard",
        "standard2",
        "standard3",
        "storage_optimized_l1",
        "storage_optimized_l2"
      ]
    },
    "openAiSkuName": {
      "type": "string",
      "defaultValue": "S0"
    },
    "languageSkuName": {
      "type": "string",
      "defaultValue": "S0"
    },
    "virtualNetworkId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the hub/spoke VNet for private DNS linking."
      }
    },
    "privateEndpointSubnetId": {
      "type": "string",
      "metadata": {
        "description": "Subnet resource ID dedicated to private endpoints."
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string"
    }
  },
  "variables": {
    "tags": {
      "env": "[parameters('environment')]",
      "owner": "[parameters('owner')]",
      "costCenter": "[parameters('costCenter')]"
    },
    "searchServiceName": "[format('{0}-search', parameters('namePrefix'))]",
    "openAiAccountName": "[format('{0}-openai', parameters('namePrefix'))]",
    "languageAccountName": "[format('{0}-language', parameters('namePrefix'))]",
    "privateDnsZoneSearch": "privatelink.search.windows.net",
    "privateDnsZoneCognitive": "privatelink.cognitiveservices.azure.com",
    "virtualNetworkName": "[last(split(parameters('virtualNetworkId'), '/'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('searchServiceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('searchSku')]"
      },
      "properties": {
        "hostingMode": "default",
        "publicNetworkAccess": "Disabled",
        "semanticSearch": "standard"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('openAiAccountName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "[parameters('openAiSkuName')]"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "publicNetworkAccess": "Disabled"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('languageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "Language",
      "sku": {
        "name": "[parameters('languageSkuName')]"
      },
      "properties": {
        "publicNetworkAccess": "Disabled",
        "disableLocalAuth": true
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[format('{0}-diag', variables('searchServiceName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ],
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "OperationLogs",
            "enabled": true
          },
          {
            "category": "SearchQueryLogs",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[format('{0}-diag', variables('openAiAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
      ],
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "Audit",
            "enabled": true
          },
          {
            "category": "RequestResponse",
            "enabled": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[format('{0}-diag', variables('languageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('languageAccountName'))]"
      ],
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "RequestResponse",
            "enabled": true
          },
          {
            "category": "Audit",
            "enabled": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('privateDnsZoneSearch')]",
      "location": "global",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('privateDnsZoneCognitive')]",
      "location": "global",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}-link', variables('privateDnsZoneSearch'), variables('virtualNetworkName'))]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneSearch'))]"
      ],
      "properties": {
        "virtualNetwork": {
          "id": "[parameters('virtualNetworkId')]"
        }
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}-link', variables('privateDnsZoneCognitive'), variables('virtualNetworkName'))]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneCognitive'))]"
      ],
      "properties": {
        "virtualNetwork": {
          "id": "[parameters('virtualNetworkId')]"
        }
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-04-01",
      "name": "[format('{0}-search-pe', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ],
      "properties": {
        "subnet": {
          "id": "[parameters('privateEndpointSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "searchConnection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
              "groupIds": [
                "searchService"
              ]
            }
          }
        ]
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-04-01",
      "name": "[format('{0}-openai-pe', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
      ],
      "properties": {
        "subnet": {
          "id": "[parameters('privateEndpointSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "openAiConnection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]",
              "groupIds": [
                "account"
              ]
            }
          }
        ]
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-search-pe/searchZoneGroup', parameters('namePrefix'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-search-pe', parameters('namePrefix')))]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "searchDnsConfig",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneSearch'))]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-openai-pe/cognitiveZoneGroup', parameters('namePrefix'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-openai-pe', parameters('namePrefix')))]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "cognitiveDnsConfig",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneCognitive'))]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2017-04-01",
      "name": "[format('{0}/CanNotDelete', variables('searchServiceName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ],
      "properties": {
        "level": "CanNotDelete",
        "notes": "Protect Azure Cognitive Search service."
      }
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2017-04-01",
      "name": "[format('{0}/CanNotDelete', variables('openAiAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
      ],
      "properties": {
        "level": "CanNotDelete",
        "notes": "Protect Azure OpenAI account."
      }
    }
  ],
  "outputs": {
    "searchServiceEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))).status.primaryEndpoints.query]"
    },
    "searchServiceResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
    },
    "openAiResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
    },
    "languageResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('languageAccountName'))]"
    }
  }
}
