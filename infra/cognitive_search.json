{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ]
    },
    "owner": {
      "type": "string"
    },
    "costCenter": {
      "type": "string"
    },
    "baseName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 11
    },
    "logAnalyticsWorkspaceId": {
      "type": "string"
    },
    "subnetResourceId": {
      "type": "string"
    },
    "privateDnsZoneId": {
      "type": "string"
    },
    "searchSku": {
      "type": "object",
      "defaultValue": {
        "name": "standard",
        "capacity": 1
      }
    },
    "archiveStorageAccountId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Storage account used for long-term diagnostic log retention."
      }
    }
  },
  "variables": {
    "tags": {
      "env": "[parameters('environment')]",
      "owner": "[parameters('owner')]",
      "costCenter": "[parameters('costCenter')]"
    },
    "searchServiceName": "[concat(parameters('baseName'), '-search')]",
    "openAiAccountName": "[concat(parameters('baseName'), '-aoai')]",
    "languageAccountName": "[concat(parameters('baseName'), '-lang')]",
    "searchPrivateEndpointName": "[concat(parameters('baseName'), '-search-pe')]",
    "aiPrivateEndpointName": "[concat(parameters('baseName'), '-ai-pe')]"
  },
  "resources": [
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('searchServiceName')]",
      "location": "[parameters('location')]",
      "sku": "[parameters('searchSku')]",
      "properties": {
        "hostingMode": "default",
        "partitionCount": 1,
        "replicaCount": 1,
        "semanticSearch": "standard",
        "encryptionWithCmk": {
          "enforcement": "Disabled"
        },
        "authOptions": {
          "aadOrApiKey": "aadAndApiKey"
        },
        "publicNetworkAccess": "Disabled"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2016-09-01",
      "name": "[concat('lock-', variables('searchServiceName'))]",
      "scope": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
      "properties": {
        "level": "CanNotDelete",
        "notes": "Guard Cognitive Search service."
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('openAiAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S0"
      },
      "kind": "OpenAI",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "publicNetworkAccess": "Disabled",
        "customSubDomainName": "[variables('openAiAccountName')]",
        "networkAcls": {
          "defaultAction": "Deny",
          "virtualNetworkRules": [
            {
              "id": "[parameters('subnetResourceId')]"
            }
          ]
        }
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('languageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S0"
      },
      "kind": "TextAnalytics",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "publicNetworkAccess": "Disabled",
        "customSubDomainName": "[variables('languageAccountName')]",
        "networkAcls": {
          "defaultAction": "Deny",
          "virtualNetworkRules": [
            {
              "id": "[parameters('subnetResourceId')]"
            }
          ]
        }
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "[variables('searchPrivateEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": {
          "id": "[parameters('subnetResourceId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "searchConnection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
              "groupIds": [
                "searchService"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ],
      "tags": "[variables('tags')]",
      "resources": [
        {
          "type": "privateDnsZoneGroups",
          "apiVersion": "2023-09-01",
          "name": "default",
          "properties": {
            "privateDnsZoneConfigs": [
              {
                "name": "searchZone",
                "properties": {
                  "privateDnsZoneId": "[parameters('privateDnsZoneId')]"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "[variables('aiPrivateEndpointName')]",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": {
          "id": "[parameters('subnetResourceId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "openAiConnection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]",
              "groupIds": [
                "account"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
      ],
      "tags": "[variables('tags')]",
      "resources": [
        {
          "type": "privateDnsZoneGroups",
          "apiVersion": "2023-09-01",
          "name": "default",
          "properties": {
            "privateDnsZoneConfigs": [
              {
                "name": "cognitiveservicesZone",
                "properties": {
                  "privateDnsZoneId": "[parameters('privateDnsZoneId')]"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('searchServiceName'), '-diag')]",
      "scope": "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]",
      "properties": {
        "storageAccountId": "[if(equals(parameters('archiveStorageAccountId'), ''), json('null'), parameters('archiveStorageAccountId'))]",
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "SearchServiceRequests",
            "enabled": true
          },
          {
            "category": "SearchQueryTimes",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', variables('searchServiceName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('openAiAccountName'), '-diag')]",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]",
      "properties": {
        "storageAccountId": "[if(equals(parameters('archiveStorageAccountId'), ''), json('null'), parameters('archiveStorageAccountId'))]",
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "Audit",
            "enabled": true
          },
          {
            "category": "RequestResponse",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('languageAccountName'), '-diag')]",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('languageAccountName'))]",
      "properties": {
        "storageAccountId": "[if(equals(parameters('archiveStorageAccountId'), ''), json('null'), parameters('archiveStorageAccountId'))]",
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "category": "Audit",
            "enabled": true
          },
          {
            "category": "RequestResponse",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('languageAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "searchServiceName": {
      "type": "string",
      "value": "[variables('searchServiceName')]"
    },
    "openAiAccountName": {
      "type": "string",
      "value": "[variables('openAiAccountName')]"
    },
    "languageAccountName": {
      "type": "string",
      "value": "[variables('languageAccountName')]"
    }
  }
}
